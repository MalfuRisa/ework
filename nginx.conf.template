server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 运行配置随容器启动生成，禁止缓存以保障切换环境后立即生效。
    location = /config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # 上游由 docker-entrypoint.sh 从 RB_PROXY_UPSTREAM 渲染。
    # 请求路径、查询参数(scope_id)和 x-environment/x-pipeline 请求头默认原样转发。
    location /rainbow-bridge/ {
        proxy_pass ${RB_PROXY_UPSTREAM}/rainbow-bridge/;
        proxy_ssl_verify off;
        proxy_set_header Host "${RB_PROXY_HOST}";
        proxy_set_header Referer "${RB_PROXY_REFERER}";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
