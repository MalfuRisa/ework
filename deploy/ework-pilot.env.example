# EWork 内网试点运行配置示例。
# 复制为 deploy/ework-pilot.env 后填写实际值，再用：
#   docker compose --env-file deploy/ework-pilot.env up -d --build
# 该文件只保存部署参数，不要提交真实内网地址或凭据。

DATA_MODE=remote
CONFIG_TYPE=rainbow-bridge

# 页面同源读取路径；Nginx 会把它转发到 RB_PROXY_UPSTREAM。
RB_BASE_URL=/rainbow-bridge

# 虹桥团队环境 key，取自 /api/v1/runtime/overview 的 environment_key。
RB_ENVIRONMENT=CHANGE_ME

# 虹桥 origin，只写 scheme://host[:port]，不要带 /rainbow-bridge。
RB_PROXY_UPSTREAM=http://CHANGE_ME:PORT

# 可选：上游需要特定 Host/Referer 时才取消注释。
# RB_PROXY_HOST=CHANGE_ME
# 显式置空表示不发送 Referer。
# RB_PROXY_REFERER=

# 自签名 HTTPS 证书场景（浏览器端仍以系统信任为准）。
SKIP_SSL_VERIFY=true
